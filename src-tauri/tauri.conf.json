{
    "productName": "Cognate",
    "version": "3.0.1",
    "identifier": "com.cognate.app",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:1420",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Cognate",
                "width": 1200,
                "height": 800,
                "minWidth": 900,
                "minHeight": 600,
                "decorations": false,
                "transparent": true,
                "center": true,
                "visible": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
        }
    },
    "plugins": {
        "updater": {
            "endpoints": [
                "https://github.com/adityatawde9699/Cognate/releases/latest/download/latest.json"
            ],
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFRDJFNTg5NjYxRTNGMjcKUldRblB4NW1pZVhTZmcxZWFJb2ppSFZkcGVUaTVUUFJmT25rN3hmdUkvejVITmhmTFFnYUhZU3cK"
        }
    },
    "bundle": {
        "active": true,
        "createUpdaterArtifacts": true,
        "targets": "all",
        "category": "Productivity",
        "publisher": "Aditya Tawde",
        "copyright": "© 2026 Aditya Tawde",
        "shortDescription": "Local-first autopilot day planner",
        "longDescription": "Cognate is a local-first planner that turns your task inbox into a time-blocked day. Tasks, plans, Pomodoro focus, and insights — stored on your device, private by default.",
        "homepage": "https://github.com/adityatawde9699/Cognate",
        "linux": {
            "deb": {
                "section": "utils"
            }
        },
        "macOS": {
            "minimumSystemVersion": "10.15"
        },
        "windows": {
            "nsis": {
                "installMode": "currentUser"
            }
        },
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}